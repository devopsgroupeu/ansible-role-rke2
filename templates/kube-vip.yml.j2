apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: kube-vip
  namespace: kube-system
spec:
  selector:
    matchLabels:
      app.kubernetes.io/name: kube-vip
  template:
    metadata:
      labels:
        app.kubernetes.io/name: kube-vip
    spec:
      serviceAccountName: kube-vip
      priorityClassName: system-node-critical
      hostNetwork: true
      nodeSelector:
        node-role.kubernetes.io/control-plane: "true"
      tolerations:
        - effect: NoSchedule
          operator: Exists
        - effect: NoExecute
          operator: Exists
      containers:
        - name: kube-vip
          image: ghcr.io/kube-vip/kube-vip:{{ rke2_kubevip_version }}
          resources:
            requests:
              cpu: "50m"
              memory: "64Mi"
          args:
            - manager
          env:
            - name: vip_arp
              value: "true"
            - name: address
              value: "{{ rke2_vip_address }}"
            - name: vip_interface
              value: "{{ rke2_vip_interface }}"
            - name: port
              value: "{{ rke2_kubevip_port }}"
            - name: vip_subnet
              value: "32"
            - name: vip_leaderelection
              value: "true"
            - name: vip_leaseduration
              value: "5"
            - name: vip_renewdeadline
              value: "3"
            - name: vip_retryperiod
              value: "1"
            - name: cp_enable
              value: "true"
            - name: cp_namespace
              value: kube-system
            - name: svc_enable
              value: "{{ 'true' if (rke2_kubevip_svc_enable | default(false) | bool or rke2_kubevip_cloud_provider_enabled | default(false) | bool) else 'false' }}"
            - name: svc_election
              value: "{{ rke2_kubevip_service_election_enable | default(false) | bool | string | lower }}"
{% if rke2_kubevip_metrics_port | default(0) | int > 0 %}
            - name: prometheus_server
              value: ":{{ rke2_kubevip_metrics_port }}"
{% endif %}
          securityContext:
            capabilities:
              add:
                - NET_ADMIN
                - NET_RAW
