{% if inventory_hostname != groups['server_nodes'][0] %}
token: {{ hostvars[groups['server_nodes'][0]]['secret_token'] }}
server: https://{{ hostvars[groups['server_nodes'][0]]['ansible_host'] | default(groups['server_nodes'][0]) }}:9345
{% endif %}

{% if rke2_cni is defined and rke2_cni != 'default' %}
cni: {{ rke2_cni }}
{% endif %}

{% set _tls_san = rke2_tls_san | list %}
{% if rke2_vip_enabled | default(false) and rke2_vip_address | default('') | length > 0 %}
{% set _tls_san = (_tls_san + [rke2_vip_address]) | unique %}
{% endif %}
{% if _tls_san | length > 0 %}
tls-san:
{% for san in _tls_san %}
  - {{ san }}
{% endfor %}
{% endif %}

{% if rke2_cluster_cidr is defined and rke2_cluster_cidr | length > 0 %}
cluster-cidr: "{{ rke2_cluster_cidr }}"
{% endif %}

{% if rke2_service_cidr is defined and rke2_service_cidr | length > 0 %}
service-cidr: "{{ rke2_service_cidr }}"
{% endif %}

{% if rke2_cluster_dns | default('') | length > 0 %}
cluster-dns: "{{ rke2_cluster_dns }}"
{% endif %}

{% if rke2_cluster_domain | default('') | length > 0 %}
cluster-domain: "{{ rke2_cluster_domain }}"
{% endif %}

{% set _server_match = rke2_server_nodes | selectattr('host', 'in', [inventory_hostname, ansible_host | default(inventory_hostname)]) | list %}
{% set _node = _server_match[0] if _server_match | length > 0 else {} %}
{% set _node_ip = _node.get('node-ip', rke2_node_ip) %}
{% set _node_ext_ip = _node.get('node-external-ip', rke2_node_external_ip) %}
{% if _node_ip | length > 0 %}
node-ip: "{{ _node_ip }}"
{% endif %}
{% if _node_ext_ip | length > 0 %}
node-external-ip: "{{ _node_ext_ip }}"
{% endif %}
{% if rke2_system_default_registry | default('') | length > 0 %}
system-default-registry: "{{ rke2_system_default_registry }}"
{% endif %}

{% if rke2_agent_token | default('') | length > 0 %}
agent-token: "{{ rke2_agent_token }}"
{% endif %}

{% if rke2_etcd_disable_snapshots | default(false) | bool %}
etcd-disable-snapshots: true
{% endif %}

{% if not (rke2_etcd_disable_snapshots | default(false) | bool) and rke2_etcd_snapshot_schedule | default('') | length > 0 %}
etcd-snapshot-schedule-cron: "{{ rke2_etcd_snapshot_schedule }}"
{% endif %}

{% if rke2_etcd_snapshot_retention | default(5) | int != 5 %}
etcd-snapshot-retention: {{ rke2_etcd_snapshot_retention | int }}
{% endif %}

{% if rke2_etcd_s3_enabled | default(false) | bool %}
etcd-s3: true
{% if rke2_etcd_s3_endpoint | default('') | length > 0 %}
etcd-s3-endpoint: "{{ rke2_etcd_s3_endpoint }}"
{% endif %}
etcd-s3-bucket: "{{ rke2_etcd_s3_bucket }}"
{% if rke2_etcd_s3_region | default('') | length > 0 %}
etcd-s3-region: "{{ rke2_etcd_s3_region }}"
{% endif %}
{% if rke2_etcd_s3_folder | default('') | length > 0 %}
etcd-s3-folder: "{{ rke2_etcd_s3_folder }}"
{% endif %}
{% if rke2_etcd_s3_access_key | default('') | length > 0 %}
etcd-s3-access-key: "{{ rke2_etcd_s3_access_key }}"
{% endif %}
{% if rke2_etcd_s3_secret_key | default('') | length > 0 %}
etcd-s3-secret-key: "{{ rke2_etcd_s3_secret_key }}"
{% endif %}
{% if rke2_etcd_s3_endpoint_ca | default('') | length > 0 %}
etcd-s3-endpoint-ca: "{{ rke2_etcd_s3_endpoint_ca }}"
{% endif %}
{% if rke2_etcd_s3_skip_ssl_verify | default(false) | bool %}
etcd-s3-skip-ssl-verify: true
{% endif %}
{% endif %}

{% set server_list = rke2_server_nodes | selectattr('host', 'in', [inventory_hostname, ansible_host | default(inventory_hostname)]) | list %}
{% set server = server_list[0] if server_list | length > 0 else {} %}

{% if server.get('node-label') %}
node-label:
{% for label in server['node-label'] %}
  - "{{ label }}"
{% endfor %}
{% endif %}

{% if server.get('node-taint') %}
node-taint:
{% for taint in server['node-taint'] %}
  - "{{ taint }}"
{% endfor %}
{% endif %}

data-dir: "{{ rke2_data_dir }}"
write-kubeconfig-mode: "{{ rke2_write_kubeconfig_mode }}"

{% if rke2_node_name | default('') | length > 0 %}
node-name: "{{ rke2_node_name }}"
{% endif %}

{% if rke2_debug | default(false) | bool %}
debug: true
{% endif %}

{% if rke2_cis_profile | default('') | length > 0 %}
profile: "{{ rke2_cis_profile }}"
{% endif %}

{% if rke2_audit_policy | default('') | length > 0 %}
audit-policy-file: "/etc/rancher/rke2/audit-policy.yaml"
{% endif %}

{% if rke2_disable_cloud_controller | default(false) | bool %}
disable-cloud-controller: true
{% endif %}

{% if rke2_cloud_provider_name | default('') | length > 0 %}
cloud-provider-name: "{{ rke2_cloud_provider_name }}"
{% endif %}

{% if rke2_selinux | default(false) | bool %}
selinux: true
{% endif %}

{% set _disable = (rke2_disable | default([])) %}
{% if rke2_ingress_controller | default('traefik') == 'none' %}
{% set _disable = (_disable + ['rke2-ingress-nginx', 'rke2-traefik']) | unique %}
{% elif rke2_ingress_controller | default('traefik') == 'traefik' %}
{% set _disable = (_disable + ['rke2-ingress-nginx']) | unique %}
{% elif rke2_ingress_controller | default('traefik') == 'ingress-nginx' %}
{% set _disable = (_disable + ['rke2-traefik']) | unique %}
{% endif %}
{% if _disable | length > 0 %}
disable:
{% for item in _disable %}
  - {{ item }}
{% endfor %}
{% endif %}

{% if rke2_disable_kube_proxy | default(false) | bool %}
disable-kube-proxy: true
{% endif %}

{% if rke2_kube_apiserver_args | default([]) | length > 0 %}
kube-apiserver-arg:
{% for arg in rke2_kube_apiserver_args %}
  - "{{ arg }}"
{% endfor %}
{% endif %}

{% if rke2_kube_scheduler_args | default([]) | length > 0 %}
kube-scheduler-arg:
{% for arg in rke2_kube_scheduler_args %}
  - "{{ arg }}"
{% endfor %}
{% endif %}

{% if rke2_kube_controller_manager_args | default([]) | length > 0 %}
kube-controller-manager-arg:
{% for arg in rke2_kube_controller_manager_args %}
  - "{{ arg }}"
{% endfor %}
{% endif %}

{% if rke2_kubelet_args | default([]) | length > 0 %}
kubelet-arg:
{% for arg in rke2_kubelet_args %}
  - "{{ arg }}"
{% endfor %}
{% endif %}

{% if rke2_kube_proxy_args | default([]) | length > 0 %}
kube-proxy-arg:
{% for arg in rke2_kube_proxy_args %}
  - "{{ arg }}"
{% endfor %}
{% endif %}

{% if rke2_extra_config | default({}) | length > 0 %}
{{ rke2_extra_config | to_nice_yaml(indent=2) | trim }}
{% endif %}
