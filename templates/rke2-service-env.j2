# RKE2 Proxy Environment Configuration
# Generated by Ansible on {{ ansible_date_time.date }}

{% if rke2_http_proxy is defined and rke2_http_proxy | length > 0 %}
HTTP_PROXY={{ rke2_http_proxy }}
{% endif %}

{% if rke2_https_proxy is defined and rke2_https_proxy | length > 0 %}
HTTPS_PROXY={{ rke2_https_proxy }}
{% endif %}

{% if rke2_no_proxy is defined and rke2_no_proxy | length > 0 %}
NO_PROXY={{ rke2_no_proxy }}
{% endif %}

{% if rke2_containerd_http_proxy is defined and rke2_containerd_http_proxy | length > 0 %}
CONTAINERD_HTTP_PROXY={{ rke2_containerd_http_proxy }}
{% endif %}

{% if rke2_containerd_https_proxy is defined and rke2_containerd_https_proxy | length > 0 %}
CONTAINERD_HTTPS_PROXY={{ rke2_containerd_https_proxy }}
{% endif %}

{% if rke2_containerd_no_proxy is defined and rke2_containerd_no_proxy | length > 0 %}
CONTAINERD_NO_PROXY={{ rke2_containerd_no_proxy }}
{% endif %}
