# Managed by Ansible - ansible-role-rke2
# keepalived VRRP configuration for RKE2 HA control plane VIP
# Unicast mode — required on cloud SDN networks where VRRP multicast (224.0.0.18) is filtered

global_defs {
  router_id {{ inventory_hostname }}
  enable_script_security
  script_user root
}

vrrp_script chk_apiserver {
  script "/etc/keepalived/check-apiserver.sh"
  interval 5
  timeout 5
  weight -20
  fall 3
  rise 2
}

vrrp_script chk_rke2server {
  script "/etc/keepalived/check-rke2server.sh"
  interval 5
  timeout 5
  weight -20
  fall 3
  rise 2
}

vrrp_instance RKE2_VIP {
  state BACKUP
  interface {{ rke2_vip_interface }}
  virtual_router_id {{ rke2_keepalived_router_id }}
  priority {{ rke2_keepalived_priority_master if inventory_hostname == groups['server_nodes'][0] else (rke2_keepalived_priority_backup - groups['server_nodes'].index(inventory_hostname)) }}
  advert_int 1
  nopreempt

  unicast_src_ip {{ hostvars[inventory_hostname]['private_ip'] | default(ansible_host) }}
  unicast_peer {
{% for host in groups['server_nodes'] %}
{% if host != inventory_hostname %}
    {{ hostvars[host]['private_ip'] | default(hostvars[host]['ansible_default_ipv4']['address']) }}
{% endif %}
{% endfor %}
  }

  authentication {
    auth_type PASS
    auth_pass {{ rke2_keepalived_auth_pass }}
  }

  virtual_ipaddress {
    {{ rke2_vip_address }}/32 dev {{ rke2_vip_interface }}
  }

  track_script {
    chk_apiserver
    chk_rke2server
  }
{% if rke2_keepalived_failover_enabled | bool %}

  notify_master "{{ rke2_keepalived_failover_script }}"
{% endif %}
}
